{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["@figma/plugin-typings"],
    "baseUrl": ".",
    "paths": {
      "@generator/*": ["src/generator/*"],
      "@ui/*": ["src/ui/*"],
      "@main/*": ["src/main/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/ui/vite.config.ts"]
}
